# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS ─────────────────────────────────────────────
# Comma-separated whitelist of allowed origins (credentialed requests require
# an explicit origin, not "*"). Sane localhost default for dev frontends.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Postgres (used by docker-compose AND by TypeORM) ──
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=monitor
DB_PASSWORD=changeme_dev_only
DB_NAME=monitor01
# Schema is owned by migrations now (src/database/migrations) — leave this
# false. Only flip true again for quick throwaway local experiments.
DB_SYNCHRONIZE=false
# Dev convenience: run pending migrations automatically on boot. In any
# shared/production environment, run `pnpm migration:run` manually instead.
DB_MIGRATIONS_RUN=true

# ── JWT / auth cookie ────────────────────────────────
# No default on purpose — app refuses to boot if this is empty.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=monitor_session
# Leave empty for a host-only cookie (correct default without subdomains).
COOKIE_DOMAIN=

# ── Seed admin (created once, only if the users table is empty) ──
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme_dev_only
